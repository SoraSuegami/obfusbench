{
  "$defs": {
    "SizeBreakdownItem": {
      "additionalProperties": false,
      "description": "One component of the output size, with the storage it accounts for.",
      "properties": {
        "component": {
          "title": "Component",
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "size_gb": {
          "title": "Size Gb",
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "component",
        "size_gb"
      ],
      "title": "SizeBreakdownItem",
      "type": "object"
    },
    "TimeBreakdownItem": {
      "additionalProperties": false,
      "description": "One sub-step of a phase, with the wall-clock time it accounts for.\n\nThe sub-steps of a phase need not sum to the phase total; the site fills the\nremainder into a synthetic \"Other\" slice at build time.",
      "properties": {
        "step": {
          "title": "Step",
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "time_hours": {
          "title": "Time Hours",
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "step",
        "time_hours"
      ],
      "title": "TimeBreakdownItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A single iO implementation benchmark entry.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string",
      "minLength": 1,
      "pattern": ".*[A-Za-z0-9].*"
    },
    "authors": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        {
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "type": "array",
          "minItems": 1
        }
      ],
      "title": "Authors"
    },
    "developers": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        {
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "type": "array",
          "minItems": 1
        }
      ],
      "title": "Developers"
    },
    "url": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^\\s/]+(?:/[^\\s]*)?$"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    },
    "commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Commit"
    },
    "date": {
      "format": "date",
      "title": "Date",
      "type": "string"
    },
    "target": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Benchmark target id (see targets in config/site.yaml). Defaults to the first configured target when omitted.",
      "title": "Target"
    },
    "device": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Short GPU id the benchmark ran on (see config/gpu_devices.yaml), e.g. 'H100', 'H200', 'A100'. Used to look up the hourly price so cost can be derived as price x total time.",
      "title": "Device"
    },
    "obfuscation_latency_sec": {
      "title": "Obfuscation Latency Sec",
      "type": "number",
      "minimum": 0
    },
    "obfuscation_total_time_hours": {
      "title": "Obfuscation Total Time Hours",
      "type": "number",
      "minimum": 0
    },
    "obfuscation_peak_memory_gb": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Obfuscation Peak Memory Gb"
    },
    "storage_gb": {
      "title": "Storage Gb",
      "type": "number",
      "minimum": 0
    },
    "evaluation_latency_sec": {
      "title": "Evaluation Latency Sec",
      "type": "number",
      "minimum": 0
    },
    "evaluation_total_time_hours": {
      "title": "Evaluation Total Time Hours",
      "type": "number",
      "minimum": 0
    },
    "evaluation_peak_memory_gb": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evaluation Peak Memory Gb"
    },
    "obfuscation_time_breakdown": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/TimeBreakdownItem"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Obfuscation Time Breakdown"
    },
    "evaluation_time_breakdown": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/TimeBreakdownItem"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evaluation Time Breakdown"
    },
    "obfuscation_size_breakdown": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/SizeBreakdownItem"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Obfuscation Size Breakdown"
    }
  },
  "required": [
    "id",
    "authors",
    "developers",
    "date",
    "obfuscation_latency_sec",
    "obfuscation_total_time_hours",
    "storage_gb",
    "evaluation_latency_sec",
    "evaluation_total_time_hours"
  ],
  "title": "Benchmark",
  "type": "object"
}
